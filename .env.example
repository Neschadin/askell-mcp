# production (default) | sandbox — server picks the host; keys are per dashboard
ASKELL_ENV=production
# ASKELL_ENV=sandbox

ASKELL_PRIVATE_API_KEY=your_secret_api_key
ASKELL_PUBLIC_API_KEY=your_public_api_key_optional

# Optional:
# ASKELL_API_URL=http://localhost:8000/api
# ASKELL_RESPONSE_MAX_BYTES=64000
# ASKELL_MUTATION_GATE=auto
# ASKELL_REQUIRE_MUTATION_APPROVAL is a deprecated alias (true→elicit, false→off)
